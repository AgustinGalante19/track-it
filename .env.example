# Sin estas variables, desarrollo usa .data/local.db y un secreto local persistente.
DATABASE_URL=file:.data/local.db
# Para Turso: DATABASE_URL=libsql://tu-base.turso.io
DATABASE_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
# Dashboard opcional de Better Auth Infrastructure. Sin clave, el login funciona localmente.
BETTER_AUTH_API_KEY=
# Con ngrok, BETTER_AUTH_URL debe ser el origen HTTPS público (sin /api/auth).
# Google opcional. Credenciales OAuth de tipo "Aplicación web", solo en el servidor.
# Callback autorizado: BETTER_AUTH_URL + /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcionales para crear/migrar una cuenta con pnpm account:create; no restringen el acceso.
OWNER_EMAIL=
# Usuario de 3 a 30 letras/números/puntos/guion bajo para ese comando.
# Producción exige URL y secreto de al menos 32 caracteres. El registro es público.
OWNER_USERNAME=
# Solo para pnpm account:create; quitar después. Nunca usar variables VITE_ para secretos.
# OWNER_NAME=Mi cuenta
# OWNER_PASSWORD=
PORT=3001
